# Copy this file to .env and fill in the values from your Supabase project:
# Dashboard → Project Settings → API (or "Data API" / "API Keys").
# Only ever use the public anon / publishable key here, never the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
